{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env", "tsconfig.json", "packages/config/**"],
  "globalEnv": [
    "CI",
    "NODE_ENV",
    "DATABASE_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "AUTH_TRUST_HOST",
    "EMAIL_FROM",
    "RESEND_API_KEY",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY"
  ],
  "globalPassThroughEnv": ["VERCEL", "VERCEL_URL", "VERCEL_ENV", "PORT"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["db:generate", "^db:generate"]
    },
    "typecheck": {
      "dependsOn": ["db:generate", "^db:generate"]
    },
    "test": {
      "dependsOn": ["db:generate", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", "prisma/**"]
    },
    "db:migrate": { "cache": false },
    "db:deploy": { "cache": false },
    "db:seed": { "cache": false, "dependsOn": ["db:generate"] },
    "db:reset": { "cache": false },
    "db:studio": { "cache": false, "persistent": true }
  }
}
