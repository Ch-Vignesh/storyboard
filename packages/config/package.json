{
  "name": "@storyboard/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and environment configuration for every Storyboard workspace.",
  "type": "module",
  "exports": {
    "./env": {
      "types": "./env.d.ts",
      "default": "./env.js"
    },
    "./load-env": {
      "types": "./load-env.d.ts",
      "default": "./load-env.js"
    },
    "./eslint/base": "./eslint/base.js",
    "./eslint/next": "./eslint/next.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./tsconfig/react-library.json": "./tsconfig/react-library.json",
    "./tsconfig/nextjs.json": "./tsconfig/nextjs.json"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "dotenv": "catalog:",
    "eslint-config-next": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "17.12.0",
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=9.22",
    "typescript": ">=5.9"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
