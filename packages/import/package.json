{
  "name": "@storyboard/import",
  "version": "0.0.0",
  "private": true,
  "description": "The import engine: a file in one of six formats becomes a proposed chapter and section split, for a person to correct. No AI anywhere (FR-3.6).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3",
    "mammoth": "1.12.3",
    "marked": "18.0.13"
  },
  "devDependencies": {
    "@storyboard/config": "workspace:*",
    "@types/node": "catalog:",
    "docx": "9.7.1",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
