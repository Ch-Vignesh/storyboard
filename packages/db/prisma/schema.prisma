// Storyboard data model. Read docs/02-architecture.md section 2 before changing
// anything about Version, Chapter, Section or Revision: the copy-on-create
// strategy and the append-only revision chain are load-bearing.
//
// Conventions
//   - Every model has an opaque `id` (cuid). Models that appear in URLs also
//     carry a short `publicId` (nanoid) so database ids never leak.
//   - Times are timestamptz. Text that users write is @db.Text.
//   - Invariants Prisma cannot express live in prisma/migrations/*_invariants:
//     revision immutability trigger, one main version per storyboard, one open
//     request per section.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

/// Decision 0043 (phase 14, item 2b.1) — who may run the place. Exactly one
/// ADMIN, kept by the partial unique index `one_admin` in the migration; a
/// SUB_ADMIN has the capabilities the admin granted (item 2b.3). Not a story
/// role: those are in `lib/authz/matrix.ts`.
enum Role {
  USER
  SUB_ADMIN
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

/// FR-2.1
enum StoryType {
  NOVEL
  NOVELLA
  SHORT_STORY
  SCREENPLAY
  STAGE_PLAY
  SERIAL
  POETRY
  NONFICTION
  OTHER
}

/// FR-2.7
enum Visibility {
  PUBLIC
  PRIVATE
}

/// FR-2.6, FR-14.1
enum StoryState {
  ACTIVE
  FINISHED
  DELETED
}

/// The owner is Storyboard.ownerId, never a Collaborator row.
enum CollabRole {
  COAUTHOR
}

/// FR-8.3 history labels
enum RevisionSource {
  AUTHORED
  ACCEPTED
  RESTORED
  IMPORTED
}

/// FR-5.2
enum RequestKind {
  REWRITE
  CONTINUE
  UNBLOCK
}

/// FR-5.9
enum RequestState {
  OPEN
  ANSWERED
  RESOLVED
  CLOSED
}

/// FR-6.4
enum SuggestionState {
  DRAFT
  SUBMITTED
  ACCEPTED
  PASSED
  STALE
  WITHDRAWN
}

/// FR-6.10 — the only reasons an author can attach to a pass. No free text.
enum PassChip {
  NOT_THE_DIRECTION
  DOES_NOT_FIT_VOICE
  TOO_FAR_FROM_OUTLINE
  SOLVED_ANOTHER_WAY
}

/// FR-9.1
enum CreditType {
  PROSE
  IDEA
  COAUTHOR
}

/// FR-12.2
enum NotificationType {
  SUGGESTION_RECEIVED
  SUGGESTION_ACCEPTED
  SUGGESTION_PASSED
  SUGGESTION_STALE
  IDEA_RECEIVED
  IDEA_MARKED_HELPFUL
  COAUTHOR_INVITED
  COAUTHOR_ACCEPTED
  SPIN_OFF_CREATED
  CONTRIBUTION_REMOVED
  REQUEST_QUIET_SEVEN_DAYS
  /// FR-2.7 and FR-14.1 — the request you were answering is no longer open.
  REQUEST_CLOSED
  /// FR-5.9 — a request you sent a suggestion to is open again.
  REQUEST_REOPENED
  IDEA_REPLY
  SUGGESTION_WITHDRAWN
  /// Item 6.15 (D-8) — a request of yours closed by itself after REQUEST_OPEN_DAYS.
  REQUEST_AUTO_CLOSED
  /// Item 7b.4 (decision 0044) — a spin-off of your story published an edition.
  SPIN_OFF_PUBLISHED
  WEEKLY_DIGEST
}

/// FR-13.5
enum ReportTarget {
  USER
  STORYBOARD
  SUGGESTION
  IDEA
}

/// FR-13.5
enum ReportCategory {
  SPAM
  ABUSE
  PLAGIARISM
  OFF_TOPIC
  LIFTED_WORK
}

enum ReportState {
  OPEN
  UPHELD
  DISMISSED
}

/// FR-3.2 — nothing is written to the tree until REVIEWED becomes COMMITTED.
enum ImportState {
  UPLOADED
  ANALYSED
  REVIEWED
  COMMITTED
  FAILED
}

// ---------------------------------------------------------------- people

model User {
  id                   String     @id @default(cuid())
  email                String     @unique
  emailVerifiedAt      DateTime?
  /// Phase 14, item 3.16 — when Google first signed this account in, or
  /// null for an account that never has. Cleared by "Disconnect Google".
  googleLinkedAt       DateTime?
  /// Item 3.16 — set by "Disconnect Google": a Google sign-in for this
  /// address is refused until the person allows it again from settings,
  /// signed in with their password. Linking by email alone would otherwise
  /// undo the disconnection on the next attempt.
  googleDisconnectedAt DateTime?
  /// Null until the "set password" onboarding step (FR-1.3).
  passwordHash         String?
  /// FR-1.7 — when the password was last reset. A session that signed in
  /// before this is refused (decision 0036), so a reset signs out every device.
  passwordChangedAt    DateTime?
  /// Item 3.3 — "Sign out on every device": a session that signed in before
  /// this is refused, as one from before a reset is.
  sessionsEndedAt      DateTime?
  /// Null until chosen during onboarding; immutable afterwards and printed in
  /// every credit line forever (FR-1.3).
  username             String?    @unique
  displayName          String?
  bio                  String?    @db.VarChar(280)
  /// Unused since phase 14, item 3.13: the picture lives in UserAvatar, as
  /// bytes. Kept so that dropping it is a decision, not a side effect.
  avatarUrl            String?
  status               UserStatus @default(ACTIVE)
  /// Read nowhere since decision 0043; `role` replaces it. Kept this phase,
  /// dropped in a non-additive one.
  isAdmin              Boolean    @default(false)
  role                 Role       @default(USER)
  /// FR-13.5 — when the account was suspended, and by whom. The work stays
  /// readable (decision 0018); what stops is signing in and writing.
  suspendedAt          DateTime?
  suspendedById        String?
  suspendedBy          User?      @relation("UserSuspender", fields: [suspendedById], references: [id])
  suspendedUsers       User[]     @relation("UserSuspender")
  /// Decision 0043 (phase 14, item 2b.5) — a ban is a suspension that neither
  /// the report review nor "Lift the suspension" undoes, and that stops the
  /// person cancelling a deletion an administrator started.
  bannedAt             DateTime?
  /// Why the account stands as it does: the note left with the last
  /// suspension, ban or deletion by an administrator. Admin eyes only;
  /// cleared with a lift.
  standingNote         String?    @db.VarChar(500)
  /// OD-3 second half, decision 0024 — when this person asked to be deleted.
  /// The account is frozen from that moment and the row is stripped of every
  /// identifying column once the grace period passes. The row itself stays: it
  /// is what every revision, credit and storyboard they touched still points
  /// at, and deleting it would take other people's work with it.
  deletionRequestedAt  DateTime?
  /// FR-13.4 — set when the person ticks "I have read the community rules"
  /// on the last onboarding step (phase 14, item 2.3). Accounts made before
  /// that were stamped at creation, when the rules were only linked.
  rulesSeenAt          DateTime?
  /// Item 2.3 — when the account was created, which is when the person agreed
  /// to the terms and the privacy policy, as the button beside the form said.
  /// Null for an account made before this landed.
  termsAcceptedAt      DateTime?
  /// Set when the four onboarding steps are complete (FR-1.3, FR-1.5).
  onboardedAt          DateTime?
  /// Decision 0043 (phase 14, item 2b.4) — the last request this account
  /// made, to the hour: written by the session read at most once an hour, by
  /// plain SQL so `updatedAt` keeps meaning a change to the account. Null for
  /// an account not seen since this landed.
  lastSeenAt           DateTime?
  /// FR-12.3 (phase 14, item 10.6) — when the weekly digest was last sent to
  /// this account. The run skips anyone sent one within
  /// WEEKLY_DIGEST_MIN_GAP_DAYS, so a run repeated by hand sends nothing
  /// twice. Written by plain SQL, as `lastSeenAt` is.
  weeklyDigestSentAt   DateTime?
  /// FR-9.4 — whether suggestions this person wrote that were passed on are
  /// shown to anyone but them. False by default: defaulting to public would
  /// make being passed on feel punitive, which FR-6.10 is at pains to avoid.
  showPassedWork       Boolean    @default(false)
  /// Phase 14, item 3.15 (screen 16) — what a new story starts as, in the
  /// create form and the import. The form still shows FR-13.6's words.
  defaultVisibility    Visibility @default(PUBLIC)
  /// NFR-5 — reading comfort, persisted per user rather than per browser.
  /// Percentages of the manuscript defaults (19px / 1.68) so they stay integers
  /// and the bounds in lib/schemas/constants.ts are exact. Decision 0009.
  readingTypeScale     Int        @default(100)
  readingLineHeight    Int        @default(168)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  featureFlagsSet     FeatureFlag[]
  pinnedGenres        UserGenre[]
  storyboards         Storyboard[]             @relation("StoryboardOwner")
  collaborations      Collaborator[]           @relation("CollaboratorUser")
  invitationsSent     Collaborator[]           @relation("CollaboratorInviter")
  versionsCreated     Version[]
  versionEvents       VersionEvent[]
  publications        Publication[]
  revisionsAuthored   Revision[]               @relation("RevisionAuthor")
  revisionsAccepted   Revision[]               @relation("RevisionAcceptor")
  drafts              SectionDraft[]
  requestsOpened      ContributionRequest[]
  suggestions         Suggestion[]             @relation("SuggestionContributor")
  suggestionsDecided  Suggestion[]             @relation("SuggestionDecider")
  ideas               Idea[]
  credits             Credit[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  reportsMade         Report[]                 @relation("Reporter")
  reportsResolved     Report[]                 @relation("ReportResolver")
  activity            ActivityDay[]
  importJobs          ImportJob[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens   EmailChangeToken[]
  adminGrants         SubAdminGrant[]          @relation("SubAdminGrantUser")
  grantsGiven         SubAdminGrant[]          @relation("SubAdminGrantGranter")
  blocksMade          UserBlock[]              @relation("BlocksMade")
  blocksReceived      UserBlock[]              @relation("BlocksReceived")
  avatar              UserAvatar?
}

/// FR-1.4 — single-use, hashed at rest, 24 h expiry, 60 s resend cooldown
/// (the cooldown is computed from the newest row's createdAt).
/// FR-1.7 — a link to choose a new password. Its own table rather than a kind
/// of verification token: it lives an hour, not a day, and a link sent to
/// confirm an address must never be able to change a password (decision 0036).
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 of the token that was emailed. The plaintext is never stored.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Phase 14, item 3.2 — a change of address, confirmed from the new address.
/// The same kind of token as a reset link's: hashed at rest, single use, an
/// hour long. Nothing about the account changes until the link is opened.
model EmailChangeToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail   String
  /// sha256 of the token that was emailed. The plaintext is never stored.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Phase 14, item 3.13 (D-5) — a profile picture, stored already cut square
/// and shrunk to AVATAR.sizePx a side as WebP, so a row is a few kilobytes
/// and no object store is needed. Served from /u/[username]/avatar;
/// `updatedAt` is the version in that URL. The purge deletes the row.
model UserAvatar {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bytes       Bytes
  contentType String   @db.VarChar(40)
  updatedAt   DateTime @updatedAt
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// sha256 of the token that was emailed. The plaintext is never stored.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model Genre {
  id   String @id @default(cuid())
  slug String @unique
  name String

  users       UserGenre[]
  storyboards StoryboardGenre[]
}

/// FR-1.3, FR-11.2 — pinned genres, ordered as the user ranked them.
model UserGenre {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  order   Int

  @@id([userId, genreId])
}

// ---------------------------------------------------------------- the work

model Storyboard {
  id            String          @id @default(cuid())
  /// nanoid; appears in URLs and as the slug suffix.
  publicId      String          @unique
  /// title slug + publicId suffix, e.g. `the-ship-never-lands-k3x9q2`.
  slug          String          @unique
  title         String          @db.VarChar(200)
  logline       String?         @db.VarChar(300)
  type          StoryType
  visibility    Visibility      @default(PUBLIC)
  state         StoryState      @default(ACTIVE)
  /// FR-14.5 — free text, displayed verbatim, never verified.
  rightsNote    String?         @db.VarChar(500)
  /// FR-15.3 — seeded example content, labelled as such in the UI.
  isSeed        Boolean         @default(false)
  /// FR-2.7 — revisions created before this instant stay private to authors.
  publicFrom    DateTime?
  /// FR-14.1
  finishedAt    DateTime?
  /// Phase 14, item 7.6 (FR-11.1, prototype) — when its newest revision was
  /// written, in any version. Kept by a trigger on every revision insert
  /// (migration `20261024010000_last_written`); a spin-off stamps its own.
  lastWrittenAt DateTime?
  /// FR-2.6 — soft delete; a job hard-deletes 30 days later.
  deletedAt     DateTime?
  /// FR-13.5, FR-13.7 (phase 14, item 2.7; decision 0045) — hidden after an
  /// upheld report: not found for anyone but its authors and the moderators.
  /// Nothing is deleted, and "Show it again" undoes it.
  hiddenAt      DateTime?
  hiddenById    String?
  hiddenReason  ReportCategory?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  ownerId String
  owner   User   @relation("StoryboardOwner", fields: [ownerId], references: [id])

  /// FR-10.3 — spin-off lineage. `forkedRevisionMap` is { lineageId: revisionId }
  /// captured at the moment of the spin-off, so "what did it look like then" is
  /// answerable forever without keeping the original's later state.
  forkedFromId        String?
  forkedFrom          Storyboard?  @relation("SpinOffs", fields: [forkedFromId], references: [id])
  forks               Storyboard[] @relation("SpinOffs")
  forkedFromVersionId String?
  forkedFromVersion   Version?     @relation("SpinOffSourceVersion", fields: [forkedFromVersionId], references: [id])
  forkedAt            DateTime?
  forkedRevisionMap   Json?

  versions      Version[]
  versionEvents VersionEvent[]
  publications  Publication[]
  collaborators Collaborator[]
  genres        StoryboardGenre[]
  credits       Credit[]
  requests      ContributionRequest[]
  importJobs    ImportJob[]
  privateSpans  PrivateSpan[]

  @@index([visibility, state, createdAt])
  @@index([ownerId])
  @@index([forkedFromId])
}

/// FR-2.7, decision 0039 — a stretch of time a story that had been public
/// spent private. What was written in it stays private to authors when the
/// story is public again, as what was written before `publicFrom` does.
/// Open (`endedAt` null) while the story is private.
model PrivateSpan {
  id           String     @id @default(cuid())
  storyboardId String
  storyboard   Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  startedAt    DateTime
  endedAt      DateTime?

  @@index([storyboardId])
}

model StoryboardGenre {
  storyboardId String
  storyboard   Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  genreId      String
  genre        Genre      @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([storyboardId, genreId])
  @@index([genreId])
}

/// SRS §3.1 — at most three accepted co-authors per storyboard (enforced in code).
model Collaborator {
  id           String     @id @default(cuid())
  storyboardId String
  storyboard   Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("CollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)
  role         CollabRole @default(COAUTHOR)
  invitedById  String
  invitedBy    User       @relation("CollaboratorInviter", fields: [invitedById], references: [id])
  invitedAt    DateTime   @default(now())
  acceptedAt   DateTime?

  @@unique([storyboardId, userId])
  @@index([userId])
}

/// Decision 0043 (phase 14, item 2b.6) — why a name is unavailable: retired
/// with a deleted account (decision 0042), or banned by an administrator.
enum RetiredReason {
  RETIRED
  BANNED
}

/// Decision 0042 (phase 14, item 1.6) — the SHA-256 of a deleted account's
/// lower-cased username, kept so the name is never taken again: it is printed
/// in credit lines and exports for ever. Written by the account purge.
/// Decision 0043 (item 2b.6) — and a name an administrator banned, kept in
/// clear with its note so the Names screen can list it; a retired name stays
/// a hash alone. The username step refuses both with the same sentence.
model RetiredUsername {
  hash      String        @id
  retiredAt DateTime      @default(now())
  reason    RetiredReason @default(RETIRED)
  name      String?
  note      String?       @db.VarChar(500)
}

/// Decision 0043 (phase 14, item 2b.3) — what the admin has let a sub-admin
/// do: one row per capability, named as in `apps/app/src/lib/authz/admin.ts`
/// and checked against that list before it is written. Demoting a sub-admin
/// deletes their rows; so does deleting either account.
model SubAdminGrant {
  userId      String
  capability  String   @db.VarChar(40)
  grantedById String
  grantedAt   DateTime @default(now())

  user      User @relation("SubAdminGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User @relation("SubAdminGrantGranter", fields: [grantedById], references: [id], onDelete: Cascade)

  @@id([userId, capability])
}

/// Decision 0046 (phase 14, item 2.9; D-9) — blocking a person. Someone you
/// block still reads every story, yours included; they cannot start, send or
/// post help on a story you own or co-write (`lib/authz`), and you hear
/// nothing from them. Their existing work stays, and can be passed.
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// "The main draft" (isMain) or an alternate version. Creating one copies the
/// chapter/section tree; revisions are shared, never copied (architecture §2).
/// Exactly one main per storyboard: partial unique index in the invariants migration.
model Version {
  id            String     @id @default(cuid())
  storyboardId  String
  storyboard    Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  name          String     @db.VarChar(120)
  isMain        Boolean    @default(false)
  baseVersionId String?
  baseVersion   Version?   @relation("VersionBase", fields: [baseVersionId], references: [id])
  derived       Version[]  @relation("VersionBase")
  createdById   String
  createdBy     User       @relation(fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  /// FR-10.1 — a removed alternate version (phase 14, item 1.1). A tombstone,
  /// like every other structural delete (decision 0008): the chapters under it
  /// are tombstoned too, and the row stays so nothing that points at it
  /// dangles. Never set on the main draft.
  deletedAt     DateTime?
  /// Decision 0044 (phase 14, item 7b.1) — set on a published edition: a
  /// copy of the main draft that never changes. Every write refuses it in
  /// `lib/authz/guard.ts`; it is not listed with the alternates.
  frozenAt      DateTime?

  chapters    Chapter[]
  spinOffs    Storyboard[]   @relation("SpinOffSourceVersion")
  /// Phase 14, item 7.10 — promotions this version was made the main draft by,
  /// and the ones it stepped down in.
  events      VersionEvent[] @relation("VersionEventVersion")
  demotions   VersionEvent[] @relation("VersionEventPrevious")
  /// Decision 0044 — the edition this frozen version is, if it is one.
  publication Publication?

  @@index([storyboardId])
}

/// Phase 14, item 7.10 (FR-10.2) — what happened to a story's versions.
enum VersionEventKind {
  PROMOTED
}

/// Phase 14, item 7.10 (FR-10.2) — "promotion swaps is_main and records the
/// swap in storyboard history". Written in the promotion's transaction, read
/// by the Versions page. Promotion wrote only a log line before this.
model VersionEvent {
  id                String           @id @default(cuid())
  storyboardId      String
  storyboard        Storyboard       @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  kind              VersionEventKind
  /// The version that became the main draft.
  versionId         String
  version           Version          @relation("VersionEventVersion", fields: [versionId], references: [id], onDelete: Cascade)
  /// The one it took over from, kept as an alternate (FR-10.2).
  previousVersionId String?
  previousVersion   Version?         @relation("VersionEventPrevious", fields: [previousVersionId], references: [id], onDelete: SetNull)
  /// What each was called at that moment, so the history reads as it was even
  /// after a rename.
  versionName       String           @db.VarChar(120)
  previousName      String?          @db.VarChar(120)
  actorId           String?
  actor             User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt         DateTime         @default(now())

  @@index([storyboardId, createdAt])
}

/// Decision 0044 (phase 14, item 7b.1) — a published edition of a story: a
/// frozen copy of its main draft, numbered 1, 2, 3 within the story. The
/// newest is the current edition. There is no unpublishing, so that is derived
/// rather than kept in a `Storyboard.currentPublicationId` that could drift.
model Publication {
  id            String     @id @default(cuid())
  storyboardId  String
  storyboard    Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  number        Int
  versionId     String     @unique
  version       Version    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  publishedById String?
  publishedBy   User?      @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt   DateTime   @default(now())
  /// What changed, in the author's words; shown with the edition.
  note          String?    @db.VarChar(280)

  @@unique([storyboardId, number])
}

model Chapter {
  id        String    @id @default(cuid())
  versionId String
  version   Version   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  /// Shared across versions that descend from the same original (architecture §2.2).
  lineageId String
  order     Int
  title     String    @db.VarChar(200)
  /// Removed from the reading order. Never a hard delete: the revisions below
  /// stay permanently addressable (FR-8.2). See decision 0008.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sections Section[]

  @@index([versionId, order])
  @@index([lineageId])
}

/// The atomic unit of contribution. A request always targets exactly one section.
model Section {
  id                String    @id @default(cuid())
  chapterId         String
  chapter           Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  lineageId         String
  order             Int
  title             String?   @db.VarChar(200)
  /// Not unique: a version copy shares its head revision with the section it
  /// was copied from (architecture §2.2). Revisions are immutable, so two
  /// sections pointing at one is the design, not a hazard. Decision 0014.
  currentRevisionId String?
  currentRevision   Revision? @relation("SectionHead", fields: [currentRevisionId], references: [id])
  wordCount         Int       @default(0)
  /// FR-2.4 — set when merged into the section above; history stays addressable.
  mergedIntoId      String?
  mergedInto        Section?  @relation("SectionMerge", fields: [mergedIntoId], references: [id])
  mergedFrom        Section[] @relation("SectionMerge")
  /// Removed from the reading order. Never a hard delete (FR-8.2); decision 0008.
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  revisions Revision[]            @relation("SectionRevisions")
  requests  ContributionRequest[]
  drafts    SectionDraft[]

  @@index([chapterId, order])
  @@index([lineageId])
}

/// Append-only. UPDATE and DELETE are refused by a trigger (NFR-3); see the
/// invariants migration for the single, explicit hard-delete escape hatch.
model Revision {
  id             String         @id @default(cuid())
  sectionId      String
  section        Section        @relation("SectionRevisions", fields: [sectionId], references: [id])
  parentId       String?
  parent         Revision?      @relation("RevisionParent", fields: [parentId], references: [id])
  children       Revision[]     @relation("RevisionParent")
  /// Canonical restricted ProseMirror document (FR-4.1).
  contentJson    Json
  /// Derived from contentJson on write; for counts, comparison and search (FR-4.3).
  contentText    String         @db.Text
  wordCount      Int
  /// sha256 of contentText — the timestamped proof of authorship (FR-13.6).
  contentHash    String
  source         RevisionSource
  /// Who wrote the words. Null once that person has erased their record
  /// (decision 0013): the prose stays, the name goes, and the interface shows
  /// "a former contributor".
  authorId       String?
  author         User?          @relation("RevisionAuthor", fields: [authorId], references: [id])
  /// Who let them in (FR-8.1). Null unless source = ACCEPTED.
  acceptedById   String?
  acceptedBy     User?          @relation("RevisionAcceptor", fields: [acceptedById], references: [id])
  suggestionId   String?        @unique
  suggestion     Suggestion?    @relation("SuggestionRevision", fields: [suggestionId], references: [id])
  /// FR-8.4 — restore never rewinds; it points at what it copied.
  restoredFromId String?
  restoredFrom   Revision?      @relation("RevisionRestore", fields: [restoredFromId], references: [id])
  restoredTo     Revision[]     @relation("RevisionRestore")
  /// FR-8.6 (phase 14, item 8.14) — why, when the person restoring said: one
  /// of FR-6.10's chips. Written with the revision and, like it, never after.
  restoreReason  PassChip?
  createdAt      DateTime       @default(now())

  /// Every section whose head this is — one per version that shares it.
  headOf             Section[]    @relation("SectionHead")
  credits            Credit[]
  suggestionsBasedOn Suggestion[] @relation("SuggestionBase")

  @@index([sectionId, createdAt])
  @@index([contentHash])
}

/// FR-4.4 — the 3-second autosave target. Per user, per section, overwritten in
/// place; a durable Revision is cut on blur, navigation, or every 5 minutes.
model SectionDraft {
  sectionId      String
  section        Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentJson    Json
  contentText    String   @db.Text
  wordCount      Int      @default(0)
  /// The revision the draft was written on; null for a section with none yet.
  /// A draft whose base is no longer the head was overtaken by someone else's
  /// save, and opening it over theirs would replace their words. Compared for
  /// equality only, so no foreign key: it is a marker, not a reference.
  baseRevisionId String?
  updatedAt      DateTime @updatedAt

  @@id([sectionId, userId])
}

// ---------------------------------------------------------------- help

/// "A spot I'm stuck on." One open request per section: partial unique index
/// in the invariants migration (FR-5.1).
model ContributionRequest {
  id             String       @id @default(cuid())
  publicId       String       @unique
  storyboardId   String
  storyboard     Storyboard   @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  kind           RequestKind
  title          String       @db.VarChar(120)
  /// 20–500 words (FR-5.3).
  ask            String       @db.Text
  /// 100–500 words; required for REWRITE and CONTINUE (FR-5.4).
  preContext     String?      @db.Text
  toneNotes      String?      @db.Text
  /// Phase 14, item 6.2 (FR-5.6) — who the people are, apart from how it sounds.
  characterNotes String?      @db.Text
  /// string[] — hard constraints shown as a checklist on the composer (FR-5.6).
  constraints    Json?
  /// lineageId[] — suggested reading, rendered inline (FR-5.5).
  readingList    Json?
  /// FR-5.8 — adjustable within 100–2000.
  minWords       Int          @default(150)
  maxWords       Int          @default(1000)
  state          RequestState @default(OPEN)
  openedById     String
  openedBy       User         @relation(fields: [openedById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  resolvedAt     DateTime?
  closedAt       DateTime?
  /// Item 6.1 — when an author last changed it after opening it; shown as "edited".
  editedAt       DateTime?
  /// Item 6.15 (D-8, decision 0050) — when it was opened, or last opened again:
  /// it closes by itself REQUEST_OPEN_DAYS later.
  openedAt       DateTime     @default(now())

  suggestions Suggestion[]
  ideas       Idea[]

  @@index([storyboardId, state])
  @@index([sectionId, state])
  @@index([state, createdAt])
}

model Suggestion {
  id             String              @id @default(cuid())
  publicId       String              @unique
  requestId      String
  request        ContributionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  contributorId  String
  contributor    User                @relation("SuggestionContributor", fields: [contributorId], references: [id])
  /// Staleness anchor: the section head this was written against (FR-6.3).
  baseRevisionId String
  baseRevision   Revision            @relation("SuggestionBase", fields: [baseRevisionId], references: [id])
  contentJson    Json
  contentText    String              @db.Text
  wordCount      Int                 @default(0)
  /// Up to 200 words to the author (FR-6.2).
  note           String?             @db.VarChar(1500)
  state          SuggestionState     @default(DRAFT)
  passReason     PassChip?
  submittedAt    DateTime?
  decidedAt      DateTime?
  decidedById    String?
  decidedBy      User?               @relation("SuggestionDecider", fields: [decidedById], references: [id])
  withdrawnAt    DateTime?
  /// FR-6.5 — when an author first opened it (phase 14, item 1.10). A
  /// withdrawal tells the authors only if this is set.
  openedAt       DateTime?
  /// Phase 14, item 6.7 (D-12) — changed by its writer after it was sent and
  /// before an author opened it; shown as "edited" wherever it appears.
  editedAt       DateTime?
  /// Decision 0045 (item 2.7) — hidden after an upheld report: reads as
  /// removed to everyone but its writer and the moderators, is no longer an
  /// answer, cannot be accepted, and holds no place in the writer's quota.
  hiddenAt       DateTime?
  hiddenById     String?
  hiddenReason   ReportCategory?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  /// The revision created when this was accepted (FR-8.1).
  revision Revision? @relation("SuggestionRevision")
  credits  Credit[]

  @@index([requestId, state])
  @@index([contributorId, state])
}

/// FR-6.9 — for UNBLOCK requests. Threaded one level deep. Never merged.
/// FR-6.9 — never merged, never a revision. At most one idea per request may
/// be marked as having helped (OD-5, decision 0010): partial unique index
/// one_helpful_idea_per_request in the migration of the same name.
model Idea {
  id            String              @id @default(cuid())
  requestId     String
  request       ContributionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                @relation(fields: [authorId], references: [id])
  parentId      String?
  parent        Idea?               @relation("IdeaThread", fields: [parentId], references: [id])
  replies       Idea[]              @relation("IdeaThread")
  /// 20–400 words, plain text.
  body          String              @db.Text
  markedHelpful Boolean             @default(false)
  /// Phase 14, item 6.8 — changed by its writer within IDEA_EDIT_MINUTES.
  editedAt      DateTime?
  /// Item 6.8 — removed by its writer; reads "Removed by its writer", replies stay.
  deletedAt     DateTime?
  /// Decision 0045 (item 2.7) — hidden after an upheld report: reads as
  /// removed to everyone but its writer and the moderators, and is no longer
  /// an answer or a candidate for "this one helped".
  hiddenAt      DateTime?
  hiddenById    String?
  hiddenReason  ReportCategory?
  createdAt     DateTime            @default(now())

  credits Credit[]

  @@index([requestId, createdAt])
  @@index([authorId])
}

/// Permanent. Survives revert (isLive = false) and spin-off (copied with
/// inheritedFromId). Principle 1.3.3: never deleted while the storyboard exists.
model Credit {
  id              String      @id @default(cuid())
  storyboardId    String
  storyboard      Storyboard  @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  /// Null once erased (decision 0013). The row stays so the contribution is
  /// still counted and an author's history gains no silent gap.
  contributorId   String?
  contributor     User?       @relation(fields: [contributorId], references: [id])
  type            CreditType
  sectionLineage  String?
  revisionId      String?
  revision        Revision?   @relation(fields: [revisionId], references: [id])
  suggestionId    String?
  suggestion      Suggestion? @relation(fields: [suggestionId], references: [id])
  ideaId          String?
  idea            Idea?       @relation(fields: [ideaId], references: [id])
  /// False once the contributed text is no longer in the main draft (FR-8.5).
  isLive          Boolean     @default(true)
  /// Decision 0013 — when the contributor asked to be unnamed. The row and its
  /// place in the count survive; the person does not.
  erasedAt        DateTime?
  /// FR-9.5 — set on credits copied into a spin-off.
  inheritedFromId String?
  inheritedFrom   Credit?     @relation("CreditInheritance", fields: [inheritedFromId], references: [id])
  inheritedBy     Credit[]    @relation("CreditInheritance")
  createdAt       DateTime    @default(now())

  @@index([contributorId, createdAt])
  @@index([storyboardId])
  @@index([revisionId])
}

// ---------------------------------------------------------------- plumbing

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// FR-12.1 — email is per-type toggleable; in-app cannot be disabled.
model NotificationPreference {
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  email  Boolean          @default(true)

  @@id([userId, type])
}

/// FR-13.5 — polymorphic target; deduplicated per reporter and target.
model Report {
  id           String         @id @default(cuid())
  reporterId   String
  reporter     User           @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTarget
  targetId     String
  category     ReportCategory
  note         String?        @db.VarChar(1000)
  state        ReportState    @default(OPEN)
  resolvedById String?
  resolvedBy   User?          @relation("ReportResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@unique([reporterId, targetType, targetId])
  @@index([state, createdAt])
  @@index([targetType, targetId])
}

/// FR-13.3 — one row per limited action, counted in a sliding window.
/// Decision 0017: Postgres until there is a Redis worth moving to. Pruned by
/// the cron runner; a row older than the longest window is of no interest.
model RateLimitHit {
  id  String   @id @default(cuid())
  /// The thing being limited, e.g. `suggestion:submit:<userId>`. Opaque here.
  key String   @db.VarChar(200)
  at  DateTime @default(now())

  @@index([key, at])
}

/// Phase 14, item 10.1 (NFR-7, D-10) — a fault of the server's own that no
/// code handled, kept so it outlives the host's brief logs and somebody hears
/// about it. Where it happened, what kind of error it was, its message cut
/// short and the top of its stack: never a request body, never what anybody
/// wrote, never who was asking. Bounds in `SERVER_ERRORS`; pruned daily.
model ServerError {
  id          String    @id @default(cuid())
  /// The same fault however often it happens: a hash of where, the error's
  /// name and its message with every value taken out.
  fingerprint String    @db.VarChar(32)
  /// `trpc`, `cron`, or Next's own: `render`, `route`, `action`, `proxy`.
  source      String    @db.VarChar(16)
  /// The procedure (`suggestion.accept`), the job, or the route as written
  /// (`/s/[slug]`): never an address with its values in it.
  location    String    @db.VarChar(200)
  name        String    @db.VarChar(100)
  message     String    @db.VarChar(500)
  /// The top frames of the stack, one to a line.
  stack       String?   @db.VarChar(2000)
  /// Set on a kind's rows when the hourly job emails the administrators
  /// about it, so that each kind is announced once.
  alertedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([fingerprint, createdAt])
  @@index([createdAt])
}

/// Phase 14, item 10.2 (NFR-7) — the socially significant moments, kept: a
/// suggestion accepted or passed, a revision restored, a spin-off, a report, a
/// promotion, an administrator's decision, an account deletion asked for,
/// cancelled or done. Written after the work it records is saved, beside its
/// log line, and never able to fail that work. Plain ids, no relations: a row
/// outlives the story it names, and an erased account keeps its id
/// (decision 0024). Never anybody's words. Pruned daily after
/// AUDIT_LOG.retentionDays.
model AuditEvent {
  id           String   @id @default(cuid())
  /// The log line's `event`, e.g. `suggestion.accepted`.
  event        String   @db.VarChar(64)
  /// Who did it; null when the place did it (the purge).
  actorId      String?
  /// Whom it was about, when that is somebody: the contributor whose
  /// suggestion was decided, the account suspended, the author whose story
  /// was spun off or reported. The Events screen's person filter reads this
  /// and `actorId`.
  subjectId    String?
  /// The story it happened on, when there is one.
  storyboardId String?
  /// What it was done to: `SUGGESTION`, `STORYBOARD`, `USER`, `SECTION`,
  /// `VERSION`, `IDEA`, `NAME` or `FLAG`, and its id (or the name, or the key).
  targetType   String?  @db.VarChar(32)
  targetId     String?
  /// A little more, in ids and settled values: a pass's chip, a report's
  /// category, a decision. Never free text anybody wrote.
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@index([storyboardId, createdAt])
}

/// FR-15.5 — a switch an owner can throw without a deploy.
model FeatureFlag {
  key         String   @id @db.VarChar(80)
  enabled     Boolean  @default(false)
  /// What it does, in the admin screen's own words.
  description String   @db.VarChar(300)
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
}

/// FR-9.3 — the contribution calendar. One row per user per active day.
model ActivityDay {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([userId, day])
}

/// FR-3.2 — holds the proposed split until the writer confirms it.
model ImportJob {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileKey      String
  fileName     String      @db.VarChar(255)
  format       String      @db.VarChar(16)
  state        ImportState @default(UPLOADED)
  /// Which detection strategy fired (FR-3.3), shown to the writer in words.
  detectedBy   String?
  proposal     Json?
  error        String?
  storyboardId String?
  storyboard   Storyboard? @relation(fields: [storyboardId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, createdAt])
}

/// NFR-2 — key is `${baseRevisionId}:${targetRevisionId}`. Revisions are
/// immutable so entries never invalidate.
model DiffCache {
  key       String   @id
  result    Json
  stats     Json
  createdAt DateTime @default(now())
}
