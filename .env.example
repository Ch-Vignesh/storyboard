# Copy to `.env` at the repository root. Every app and package reads this one file.
# Never commit `.env`.

# -- Database -----------------------------------------------------------------
# Local: `docker compose up -d` provides this exact database.
# Hosted: a Neon pooled connection string works unchanged.
DATABASE_URL="postgresql://storyboard:storyboard@localhost:5432/storyboard"

# -- Auth.js ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Only needed outside Vercel, or when the public URL differs from the request host.
AUTH_URL="http://localhost:3200"
AUTH_TRUST_HOST="true"

# -- Email (FR-12) ------------------------------------------------------------
# Leave RESEND_API_KEY empty in development: emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Storyboard <hello@example.com>"

# -- Public URLs --------------------------------------------------------------
# These must match the ports in the apps' dev/start scripts (apps/app is 3200,
# apps/web is 3201). They are not cosmetic: NEXT_PUBLIC_APP_URL is the host in
# every verification link that gets emailed, and AUTH_URL is where Auth.js sends
# people back to after signing in. Point them at a port something else is
# serving and sign-up will hand your users to that other server.
NEXT_PUBLIC_APP_URL="http://localhost:3200"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3201"

# -- Scheduled email (FR-12.3, decision 0012) ---------------------------------
# Authorises POST /api/cron/{immediate,hourly,weekly,nudge}. Generate with:
#   openssl rand -hex 32
# Leave empty in development: the endpoint refuses to run without it, and
# `pnpm cron <job>` calls the same work directly.
CRON_SECRET=""

# -- Introduced in later phases (see docs/04-phase-plan.md) -------------------
# Deferred: Inngest, if scheduled work ever needs durable retries (decision 0012)
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
# Phase 5: import uploads and export files
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# Phase 6: rate limits
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
