# Copy to `.env` at the repository root. Every app and package reads this one file.
# Never commit `.env`.

# -- Database -----------------------------------------------------------------
# Local: `docker compose up -d` provides this exact database.
# Hosted: a Neon pooled connection string works unchanged.
DATABASE_URL="postgresql://storyboard:storyboard@localhost:5432/storyboard"
# Migrations only. A hosted Postgres usually offers a pooled URL and a direct one;
# DDL cannot run over a transaction-mode pooler, so `pnpm db:deploy` uses this when
# it is set and DATABASE_URL otherwise. Leave empty locally: one database is both.
DIRECT_DATABASE_URL=""

# -- Auth.js ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Only needed outside Vercel, or when the public URL differs from the request host.
AUTH_URL="http://localhost:3200"
AUTH_TRUST_HOST="true"

# -- Email (FR-12) ------------------------------------------------------------
# Leave RESEND_API_KEY empty in development: emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Storyboard <hello@example.com>"

# -- Signing in with Google (FR-1.6, decision 0027) ---------------------------
# Both or neither. With neither the provider is not registered and the button is
# not rendered. Create an OAuth client at console.cloud.google.com and set the
# redirect URI to {NEXT_PUBLIC_APP_URL}/api/auth/callback/google.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# -- Public URLs --------------------------------------------------------------
# These must match the ports in the apps' dev/start scripts (apps/app is 3200,
# apps/web is 3201). They are not cosmetic: NEXT_PUBLIC_APP_URL is the host in
# every verification link that gets emailed, and AUTH_URL is where Auth.js sends
# people back to after signing in. Point them at a port something else is
# serving and sign-up will hand your users to that other server.
NEXT_PUBLIC_APP_URL="http://localhost:3200"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3201"

# -- Scheduled email (FR-12.3, decision 0012) ---------------------------------
# Authorises POST /api/cron/{immediate,hourly,weekly,nudge}. Generate with:
#   openssl rand -hex 32
# Leave empty in development: the endpoint refuses to run without it, and
# `pnpm cron <job>` calls the same work directly.
CRON_SECRET=""

# -- Introduced in later phases (see docs/04-phase-plan.md) -------------------
# Deferred: Inngest, if scheduled work ever needs durable retries (decision 0012)
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
# Manuscript uploads (FR-3.1). All four or none: set none and uploads are
# written to .uploads/ on the application server instead, which is how this
# repository runs without a Cloudflare account. See apps/app/src/server/storage.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# Rate limits in Redis instead of Postgres (FR-13.3, decision 0017, added in
# phase 9). Both or neither. With neither, the Postgres sliding window runs —
# which is not a fallback, it is what has enforced these limits since phase 6.
# Set these only when a limit check shows up in a slow query log.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
