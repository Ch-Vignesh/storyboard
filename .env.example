# Copy to `.env` at the repository root. Every app and package reads this one file.
# Never commit `.env`.

# -- Database -----------------------------------------------------------------
# Local: `docker compose up -d` provides this exact database.
# Hosted: a Neon pooled connection string works unchanged.
DATABASE_URL="postgresql://storyboard:storyboard@localhost:5432/storyboard"

# -- Auth.js ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Only needed outside Vercel, or when the public URL differs from the request host.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# -- Email (FR-12) ------------------------------------------------------------
# Leave RESEND_API_KEY empty in development: emails are printed to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Storyboard <hello@example.com>"

# -- Public URLs --------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_MARKETING_URL="http://localhost:3001"

# -- Introduced in later phases (see docs/04-phase-plan.md) -------------------
# Phase 3: background jobs and digests
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
# Phase 5: import uploads and export files
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# Phase 6: rate limits
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
